# ── Copy to .env and fill in values. Never commit .env ──────────────────
# This file lists variable NAMES only — no real secrets.

# ── Core ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DATABASE_URL=
TEST_DATABASE_URL=

# ── OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_TEXT=
OPENAI_MODEL_MULTIMODAL=
OPENAI_MODEL_TEASER=
OPENAI_EXTRACTION_MODEL=

# ── Facebook Messenger ─────────────────────────────────────────────────
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=
FB_APP_SECRET=
WEBHOOK_SKIP_SIGNATURE_VERIFY=0

# ── Admin bootstrap (first-run only) ────────────────────────────────────
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_COOKIE_SECURE=0

# ── Security / HMAC ─────────────────────────────────────────────────────
USER_HASH_HMAC_SECRET=

# ── Observability ───────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Storage (disk | r2) ─────────────────────────────────────────────────
STORAGE_BACKEND=disk
STORAGE_DISK_ROOT_PATH=./storage
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Alternative names used in render.yaml (map to R2_* above if needed):
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# ── Worker / runtime ────────────────────────────────────────────────────
RUN_WORKER=0
SKIP_DB_BOOTSTRAP=0
WORKER_KINDS=
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_SEC=2.0
WORKER_BACKOFF_BASE_SEC=15
WORKER_BACKOFF_CAP_SEC=300
DB_POOL_MAX=10

# ── Cost caps (example defaults — adjust per environment) ───────────────
CAP_MODEL_CALLS_SESSION=12
CAP_MODEL_CALLS_DAY_REGULAR=30
CAP_IMAGE_ANALYZE_DAY=3
CAP_RENDERS_DAY=2
CAP_VND_DAY_REGULAR=15000
CAP_VND_DAY_SUPPORTER=50000
CAP_TOKENS_DAY_REGULAR=250000
VND_USD_EXCHANGE_RATE=25000

# ── Feature flags ───────────────────────────────────────────────────────
DEBUG_CHAT_ENABLED=0
MULTIMODAL_ENABLED=0
RUNTIME_PUBLISH_SAFE=0
RUNTIME_METRICS_ENABLED=0
QUEUED_ACK_ENABLED=0
PREMIUM_TRIGGER_ENABLED=0
FREE_DAILY_ASTROLOGY_LIMIT_ENABLED=0
FREE_DAILY_ASTROLOGY_LIMIT=5

# ── Render deploy (ops scripts only) ────────────────────────────────────
RENDER_API_KEY=
RENDER_PUBLIC_URL=https://example-backend.onrender.com
RENDER_WEB_SERVICE_ID=
RENDER_WORKER_SERVICE_ID=
RENDER_DB_NAME=
RENDER_OWNER_ID=

# ── Deploy metadata (optional) ──────────────────────────────────────────
GIT_SHA=
BUILD_TIME=
